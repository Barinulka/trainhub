{
    "name": "aleksejbarinov/train-hub",
    "type": "project",
    "description": "Учебный проект ориентированный на создание сервиса для фитнес тренеров",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "al.barinov",
            "email": "al.barinov@academcity.online"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "require": {
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/console": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/flex": "^2",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "symfony/validator": "^8.1",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/serializer": "^8.1",
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
